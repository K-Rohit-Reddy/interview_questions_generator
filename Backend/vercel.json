{
  "version": 2,
  "builds": [
    {
      "src": "main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/main.py"
    }
  ],
  "env": {
    "MONGO_USERNAME": "@mongo_username",
    "MONGO_PASSWORD": "@mongo_password",
    "MONGO_CLUSTER": "@mongo_cluster",
    "MONGO_DATABASE": "@mongo_database",
    "GROQ_API_KEY": "@groq_api_key"
  }
}